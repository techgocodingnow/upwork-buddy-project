# Release signing secrets for the GitHub Actions Release workflow.
#
# Copy to `.env` (gitignored), fill in the blanks, then run:
#   Scripts/set-github-secrets.sh
# which base64-encodes the file paths and pushes every value with `gh secret set`.
#
# Nothing here is read by the app at runtime — these only feed CI signing +
# notarization in .github/workflows/release.yml.

# --- App config -------------------------------------------------------------
# Path to your local (gitignored) Config.plist. Encoded into CONFIG_PLIST_BASE64.
CONFIG_PLIST_PATH=Sources/UpworkBuddy/Resources/Config.plist

# --- Developer ID code-signing cert ----------------------------------------
# Path to your exported "Developer ID Application" .p12 (cert + private key).
# Export via Keychain Access > My Certificates > right-click > Export.
# Encoded into BUILD_CERTIFICATE_BASE64.
P12_PATH=
# The password you set when exporting the .p12.
P12_PASSWORD=

# Throwaway password for the temporary CI keychain (any value).
KEYCHAIN_PASSWORD=

# --- Apple notarization ------------------------------------------------------
NOTARY_APPLE_ID=
NOTARY_TEAM_ID=L23PD654Q3
# App-specific password from appleid.apple.com (format: xxxx-xxxx-xxxx-xxxx).
NOTARY_PASSWORD=

# --- Sparkle auto-update (optional) -----------------------------------------
# EdDSA private key from Sparkle's generate_keys. Leave blank to skip appcast.
SPARKLE_PRIVATE_KEY=
